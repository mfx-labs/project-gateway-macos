{
  "name": "@project-gateway/artifact-core",
  "version": "0.1.0",
  "description": "Consumer-neutral Artifact Core library: deterministic validation and protocol evaluation for the Project Gateway artifact protocol (WP-0..WP-3).",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi-adapter": {
      "types": "./dist/adapters/pi/index.d.ts",
      "import": "./dist/adapters/pi/index.js"
    },
    "./loading": {
      "types": "./dist/loading/index.d.ts",
      "import": "./dist/loading/index.js"
    },
    "./mcp": {
      "types": "./dist/adapters/mcp/index.d.ts",
      "import": "./dist/adapters/mcp/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "generate": "node scripts/generate-bundle.mjs",
    "build": "npm run generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run clean:generated && npm run build && tsc -p tsconfig.tests.json && node scripts/wp7-discovery-guard.mjs && node --test \"dist-test/tests/unit/*.test.js\" \"dist-test/tests/integration/*.test.js\" \"dist-test/tests/security/*.test.js\" \"dist-test/tests/pi-adapter/unit/*.test.js\" \"dist-test/tests/pi-adapter/integration/*.test.js\" \"dist-test/tests/pi-adapter/security/*.test.js\" \"dist-test/tests/pi-adapter/compatibility/*.test.js\" \"dist-test/tests/pi-adapter/enforcement/*.test.js\" \"dist-test/tests/mcp/unit/*.test.js\" \"dist-test/tests/runtime/*.test.js\" \"dist-test/tests/drafting/*.test.js\" \"dist-test/tests/writing/*.test.js\" \"dist-test/tests/trusted/*.test.js\" \"dist-test/tests/pointofuse-v2/*.test.js\" && node scripts/run-wp7-tests.mjs",
    "test:unit": "node --test \"dist-test/tests/unit/*.test.js\"",
    "test:integration": "node --test \"dist-test/tests/integration/*.test.js\"",
    "test:conformance": "node --test \"dist-test/tests/integration/*.test.js\"",
    "test:security": "node --test \"dist-test/tests/security/*.test.js\"",
    "test:pi-adapter": "node --test \"dist-test/tests/pi-adapter/unit/*.test.js\" \"dist-test/tests/pi-adapter/integration/*.test.js\" \"dist-test/tests/pi-adapter/security/*.test.js\" \"dist-test/tests/pi-adapter/compatibility/*.test.js\" \"dist-test/tests/pi-adapter/enforcement/*.test.js\"",
    "test:mcp": "node --test \"dist-test/tests/mcp/unit/*.test.js\"",
    "test:pointofuse-v2": "node --test \"dist-test/tests/pointofuse-v2/*.test.js\"",
    "test:storage": "node scripts/run-test-surface.mjs dist-test/tests/unit/storage",
    "test:loading": "node scripts/run-test-surface.mjs dist-test/tests/loading",
    "test:wp7-reader": "node --test \"dist-test/tests/wp7/reader/*.test.js\"",
    "test:wp7-git": "node --test \"dist-test/tests/wp7/git/*.test.js\"",
    "test:wp7-fff": "node --test \"dist-test/tests/wp7/fff/*.test.js\"",
    "test:wp7-security": "node --test \"dist-test/tests/wp7/security/*.test.js\"",
    "test:storage-crash": "node --test \"dist-test/tests/process/storage-crash/*.test.js\"",
    "clean:generated": "node scripts/clean-generated.mjs",
    "test:runtime": "node --test \"dist-test/tests/runtime/*.test.js\"",
    "build:native": "node scripts/build-native.mjs x64",
    "build:native:arm64": "node scripts/build-native.mjs arm64",
    "test:native": "node --test \"native/test/*.test.mjs\""
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "8.20.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.1.2",
    "node-gyp": "^13.0.1",
    "typescript": "7.0.2"
  },
  "bin": {
    "project-gateway-mcp": "./dist/runtime/mcp/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mfx-labs/project-gateway.git"
  }
}
